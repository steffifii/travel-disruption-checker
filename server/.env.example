# Make a copy of this file called ".env".
# No API keys are needed: all three data sources are free U.S. government services.

# The port the backend listens on.
PORT=3001

# The National Weather Service asks every app to identify itself with a name
# and a contact email, so they can get in touch if there's a problem.
# Replace the email with yours.
NWS_USER_AGENT=TripDisruptionChecker (your-email@example.com)
